FROM rocker/r-ver:4.5.2

# System dependencies for Python, ML libraries, and R packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff5-dev \
    libavformat-dev \
    libavcodec-dev \
    libavutil-dev \
    libswscale-dev \
    libxext6 \
    libxrender1 \
    libxt6 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Python ML stack (CPU versions)
RUN pip install \
    torch --index-url https://download.pytorch.org/whl/cpu \
    tensorflow-cpu \
    scikit-learn \
    xgboost \
    lightgbm \
    opencv-python

# Install remotes for R package installation
RUN R -e "install.packages('remotes', repos = 'https://cloud.r-project.org')"

WORKDIR /workspace
COPY . /workspace

# Install your R package and its dependencies
RUN R -e "remotes::install_local('/workspace', upgrade = 'never')"

# Configure reticulate to use system Python
ENV RETICULATE_PYTHON=/usr/bin/python3

CMD ["bash"]
